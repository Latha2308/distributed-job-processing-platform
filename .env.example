# Application
APP_NAME=Distributed Job Processing Platform
APP_VERSION=1.0.0
DEBUG=True
ENVIRONMENT=development

# API
API_V1_PREFIX=/api/v1
SECRET_KEY=change-this-to-a-random-secret-key-at-least-32-characters-long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS Configuration (JSON array format required)
# For development with frontend: ["http://localhost:3000","http://localhost:8000"]
# For open access (development only): ["*"]
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/jobprocessing
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_POOL_SIZE=10

# AWS SQS
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/your-account/job-queue
SQS_DLQ_URL=https://sqs.us-east-1.amazonaws.com/your-account/job-dlq

# Worker Configuration
WORKER_COUNT=3
WORKER_PREFETCH_COUNT=5
MAX_RETRIES=3
RETRY_BACKOFF_BASE=2
INITIAL_RETRY_DELAY=1

# Rate Limiting
RATE_LIMIT_PER_MINUTE=100

# Monitoring
ENABLE_METRICS=True
METRICS_PORT=9090

# WebSocket
WS_HEARTBEAT_INTERVAL=30

# Job Configuration
JOB_TIMEOUT=300
MAX_JOB_AGE_DAYS=30

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
